# Durable research state
RESEARCH_GITHUB_REPO=YOUR_GITHUB_USER/YOUR_RESEARCH_REPO
RESEARCH_GITHUB_BRANCH=main
RESEARCH_TIMEZONE=UTC

# Inject from a secret manager in production. Never commit a real token.
GITHUB_TOKEN=REPLACE_WITH_SECRET_INJECTION

# Remote MCP URL and OAuth/OIDC protection
MCP_PUBLIC_URL=https://YOUR_MCP_HOST
MCP_AUTH_ENABLED=true
MCP_AUTH_ISSUER_URL=https://YOUR_ISSUER/
MCP_AUTH_AUDIENCE=YOUR_AUDIENCE
MCP_AUTH_JWKS_URL=https://YOUR_ISSUER/.well-known/jwks.json
MCP_REQUIRED_SCOPES=research:mcp
MCP_AUTH_ALGORITHMS=RS256

# Optional hardening
MCP_ALLOWED_SUBJECTS=
MCP_ALLOWED_ORIGINS=
